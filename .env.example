# ============================================================
# ChronicAI — Environment Configuration
# Copy this file to .env.local (local dev) or .env (Docker)
# ============================================================

# --- Supabase Configuration ---
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# --- AI Provider (gemini | openai | anthropic | mock) ---
AI_PROVIDER=mock
AI_API_KEY=mock-key
AI_MODEL=gemini-1.5-pro

# --- Application URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Docker Configuration ---
# Port to expose the app on the host machine
APP_PORT=3000
